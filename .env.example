# Required: connection string for the MongoDB cluster
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Required: signing secret for JWTs. Use a long random string.
# The server refuses to start if this is unset.
JWT_SECRET=

# Optional: enables Google OAuth login. If empty, /api/auth/google returns 503.
GOOGLE_CLIENT_ID=

# Optional: required header value for /api/admin/* routes (sent as `x-admin-key`).
# Without this set, admin routes return 503.
ADMIN_KEY=

# Optional: comma-separated additional CORS origins beyond the built-in allowlist
# (https://aporialab.space, https://www.aporialab.space, the canonical
# Vercel domain, and localhost dev ports).
ALLOWED_ORIGINS=

# Optional: enables avatar upload via Cloudinary.
# All three must be set, otherwise /api/users/avatar/signature and
# /api/users/avatar return 503. Avatars are stored under the
# `aporialab/avatars` folder on Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: enables transactional email (verification + password reset) via Resend.
# When unset, /api/auth/forgot-password silently no-ops and /api/auth/resend-verification
# returns 503. Registration still works but no verification email goes out.
RESEND_API_KEY=

# Sender address used on outgoing email. Default uses Resend's sandbox domain which
# only delivers to addresses added as verified test recipients in the Resend dashboard.
# Switch to `AporiaLab <noreply@aporialab.space>` once DKIM is configured for the domain.
EMAIL_FROM=AporiaLab <onboarding@resend.dev>

# Public URL of the frontend, used to build verification and password-reset links.
# Override to http://localhost:5173 for local dev.
FRONTEND_URL=https://aporialab.space
